@page
@model HelpDeskRazor.Pages.Tickets.DetailsModel
@{ ViewData["Title"] = $"Ticket #{Model.Ticket.Id}"; }
<div class="page-heading"><div><div class="eyebrow">Tickets / #@Model.Ticket.Id</div><h1>Ticket #@Model.Ticket.Id</h1></div><a class="btn btn-primary" asp-page="/Tickets/Create" asp-route-id="@Model.Ticket.Id">Edit</a></div>
<div class="detail-grid"><div><div class="panel"><h2>General Information</h2><div class="detail-list"><div><label>Subject</label><span>@Model.Ticket.Subject</span></div><div><label>Description</label><span>@Model.Ticket.Description</span></div><div><label>Status</label><span class="badge status-open">@Model.Ticket.Status</span></div><div><label>Priority</label><span class="badge priority-high">@Model.Ticket.Priority</span></div><div><label>Team</label><span>@Model.Ticket.Team</span></div><div><label>Assigned To</label><span>@Model.Ticket.AssignedTo</span></div><div><label>Created</label><span>@Model.Ticket.Created</span></div></div></div><div class="panel comments"><div class="panel-title"><h2>Comments</h2><button class="btn btn-secondary">＋ Add Comment</button></div><div class="comment"><span class="avatar">E</span><div><b>Emily Carter</b><small>Sep 25, 2026 9:14 AM</small><p>I am unable to access my Outlook email.</p></div></div><div class="comment"><span class="avatar">J</span><div><b>John Smith</b><small>Sep 25, 2026 10:02 AM</small><p>I’m looking into this now.</p></div></div></div></div><div><div class="panel"><h2>Requester</h2><div class="person"><span class="avatar large">E</span><div><b>@Model.Ticket.Requester</b><small>emily.carter@company.com</small></div></div></div><div class="panel"><h2>Team</h2><div class="person"><span class="avatar large">IT</span><b>@Model.Ticket.Team</b></div></div><div class="panel"><h2>Assigned To</h2><div class="person"><span class="avatar large">J</span><div><b>@Model.Ticket.AssignedTo</b><small>john.smith@company.com</small></div></div></div></div></div>
