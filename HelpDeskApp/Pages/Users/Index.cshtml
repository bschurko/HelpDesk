@page
@model HelpDesk.App.Pages.Users.IndexModel

@{
    ViewData["Title"] = "Users";
}

<div class="page-heading">

    <div>
        <h1>Users</h1>
        <p>Manage helpdesk users and requesters</p>
    </div>

    <button class="btn btn-primary">
        ＋ Add User
    </button>

</div>


<div class="panel">

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Team</th>
                <th>Created Date</th>
              
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>
                        @user.Id
                    </td>
                    <td class="strong">
                        @user.FirstName @user.LastName
                    </td>

                    <td>
                        @user.Email
                    </td>

                    <td>
                        @user.Team.Name
                    </td>

                    <td>
                         @user.DateCreated
                    </td>
                </tr>
            } 
         </tbody>
    </table>
</div>