<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpDeskApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpDeskApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet asp-append-version="true" href="~/css/site.css" />

</head>
<body>

    <div class="helpdesk-layout">

        <aside class="helpdesk-sidebar">

            <div class="sidebar-logo">
                <div class="sidebar-logo-icon">
                    🎧
                </div>
                <span>HelpDesk</span>
            </div>

            <nav class="sidebar-nav">

                <a class="nav-item"
                   asp-page="/Tickets/Index">
                    <span class="nav-icon">🎫</span>
                    <span class="nav-text">Tickets</span>
                </a>

                <a class="nav-item"
                   asp-page="/Users/Index">
                    <span class="nav-icon">👤</span>
                    <span class="nav-text">Users</span>
                </a>

                <a class="nav-item"
                   asp-page="/Teams/Index">
                    <span class="nav-icon">👥</span>
                    <span class="nav-text">Teams</span>
                </a>

            </nav>

        </aside>


        <div class="helpdesk-main">

            <header class="helpdesk-topbar">

                <div class="header-search">
                    <input type="text"
                           placeholder="Search tickets..." />
                </div>

                <div class="user-menu">
                    <div class="user-avatar">
                        A
                    </div>

                    <span class="user-name">
                        Administrator
                    </span>
                </div>

            </header>


            <main class="helpdesk-content">

                @RenderBody()

            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
